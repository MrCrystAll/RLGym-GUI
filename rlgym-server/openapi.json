{
  "openapi": "3.1.0",
  "info": {
    "title": "RLGym GUI backend",
    "version": "0.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get Health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get Version",
        "operationId": "get_version",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Get Settings",
        "operationId": "get_settings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update Settings",
        "operationId": "update_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/python/info": {
      "get": {
        "tags": [
          "discovery"
        ],
        "summary": "Get Python Info",
        "operationId": "get_python_info",
        "parameters": [
          {
            "name": "python",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Interpreter to check instead of the saved one",
              "title": "Python"
            },
            "description": "Interpreter to check instead of the saved one"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PythonInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/components/discover": {
      "post": {
        "tags": [
          "discovery"
        ],
        "summary": "Discover Components",
        "operationId": "discover_components",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiscoverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoverResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/configs": {
      "get": {
        "tags": [
          "configs"
        ],
        "summary": "List Configs",
        "description": "Most recently updated first.",
        "operationId": "list_configs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConfigSummary"
                  },
                  "type": "array",
                  "title": "Response List Configs"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "configs"
        ],
        "summary": "Create Config",
        "operationId": "create_config",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/configs/{config_id}": {
      "get": {
        "tags": [
          "configs"
        ],
        "summary": "Get Config",
        "operationId": "get_config",
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Config Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "configs"
        ],
        "summary": "Update Config",
        "operationId": "update_config",
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Config Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvConfig"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "configs"
        ],
        "summary": "Delete Config",
        "operationId": "delete_config",
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Config Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/configs/{config_id}/export": {
      "get": {
        "tags": [
          "configs"
        ],
        "summary": "Export Config",
        "operationId": "export_config",
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Config Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ExportFormat"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigExport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentChoice": {
        "properties": {
          "qualified_name": {
            "type": "string",
            "minLength": 1,
            "title": "Qualified Name",
            "description": "e.g. my_bot.rewards.GoalReward"
          },
          "params": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Params",
            "description": "Constructor arguments as Python literal expressions, e.g. '1.0', 'None', \"'blue'\"; omitted ones use their default"
          }
        },
        "type": "object",
        "required": [
          "qualified_name"
        ],
        "title": "ComponentChoice"
      },
      "ComponentParam": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default",
            "description": "repr() of the default; null when required"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          }
        },
        "type": "object",
        "required": [
          "name",
          "type",
          "default",
          "required"
        ],
        "title": "ComponentParam"
      },
      "ConfigExport": {
        "properties": {
          "format": {
            "$ref": "#/components/schemas/ExportFormat"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "Suggested file name, derived from the config name"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "missing_slots": {
            "items": {
              "type": "string",
              "enum": [
                "transition_engine",
                "state_mutator",
                "obs_builder",
                "action_parser",
                "reward_fn",
                "termination_cond",
                "truncation_cond",
                "shared_info_provider"
              ]
            },
            "type": "array",
            "title": "Missing Slots",
            "description": "Required slots without a component; the Python formats leave `...` in their place"
          }
        },
        "type": "object",
        "required": [
          "format",
          "filename",
          "content",
          "missing_slots"
        ],
        "title": "ConfigExport"
      },
      "ConfigIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "title": "Name"
          },
          "components": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentChoice"
            },
            "propertyNames": {
              "enum": [
                "transition_engine",
                "state_mutator",
                "obs_builder",
                "action_parser",
                "reward_fn",
                "termination_cond",
                "truncation_cond",
                "shared_info_provider"
              ]
            },
            "type": "object",
            "title": "Components",
            "description": "The chosen component per slot; a missing slot isn't chosen yet"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ConfigIn"
      },
      "ConfigSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "slots": {
            "items": {
              "type": "string",
              "enum": [
                "transition_engine",
                "state_mutator",
                "obs_builder",
                "action_parser",
                "reward_fn",
                "termination_cond",
                "truncation_cond",
                "shared_info_provider"
              ]
            },
            "type": "array",
            "title": "Slots",
            "description": "Slots with a component chosen"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "description": "Every required slot has a component"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "updated_at",
          "slots",
          "complete"
        ],
        "title": "ConfigSummary"
      },
      "DiscoverRequest": {
        "properties": {
          "modules": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modules",
            "description": "Modules to scan; the saved list when omitted"
          }
        },
        "type": "object",
        "title": "DiscoverRequest"
      },
      "DiscoverResult": {
        "properties": {
          "components": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/DiscoveredComponent"
              },
              "type": "array"
            },
            "propertyNames": {
              "enum": [
                "transition_engine",
                "state_mutator",
                "obs_builder",
                "action_parser",
                "reward_function",
                "done_condition",
                "shared_info_provider"
              ]
            },
            "type": "object",
            "title": "Components",
            "description": "Every kind is present, possibly with an empty list"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ModuleError"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "components",
          "errors"
        ],
        "title": "DiscoverResult"
      },
      "DiscoveredComponent": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "transition_engine",
              "state_mutator",
              "obs_builder",
              "action_parser",
              "reward_function",
              "done_condition",
              "shared_info_provider"
            ],
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "module": {
            "type": "string",
            "title": "Module"
          },
          "qualified_name": {
            "type": "string",
            "title": "Qualified Name"
          },
          "doc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc"
          },
          "params": {
            "items": {
              "$ref": "#/components/schemas/ComponentParam"
            },
            "type": "array",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "name",
          "module",
          "qualified_name",
          "doc",
          "params"
        ],
        "title": "DiscoveredComponent"
      },
      "EnvConfig": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "title": "Name"
          },
          "components": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentChoice"
            },
            "propertyNames": {
              "enum": [
                "transition_engine",
                "state_mutator",
                "obs_builder",
                "action_parser",
                "reward_fn",
                "termination_cond",
                "truncation_cond",
                "shared_info_provider"
              ]
            },
            "type": "object",
            "title": "Components",
            "description": "The chosen component per slot; a missing slot isn't chosen yet"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "id",
          "created_at",
          "updated_at"
        ],
        "title": "EnvConfig"
      },
      "ExportFormat": {
        "type": "string",
        "enum": [
          "snippet",
          "script",
          "json"
        ],
        "title": "ExportFormat"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "ModuleError": {
        "properties": {
          "module": {
            "type": "string",
            "title": "Module"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "module",
          "message"
        ],
        "title": "ModuleError"
      },
      "PythonInfo": {
        "properties": {
          "python": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Python",
            "description": "Python version, e.g. 3.12.2; null if it didn't start"
          },
          "executable": {
            "type": "string",
            "title": "Executable"
          },
          "rlgym_api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rlgym Api",
            "description": "Installed rlgym-api version; null if not importable"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Why the interpreter or rlgym.api couldn't be used"
          }
        },
        "type": "object",
        "required": [
          "python",
          "executable",
          "rlgym_api",
          "error"
        ],
        "title": "PythonInfo"
      },
      "Settings": {
        "properties": {
          "python": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Python",
            "description": "Path to the Python executable that runs the worker"
          },
          "modules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Modules",
            "description": "Modules to scan for RLGym components"
          }
        },
        "type": "object",
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Version": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "Version"
      }
    }
  }
}
