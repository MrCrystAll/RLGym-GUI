{
  "name": "rlgym-app",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n ng,api -c blue,magenta \"ng serve\" \"npm:gen:api:watch\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen:spec": "node scripts/gen-spec.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:watch": "concurrently -n spec,client \"chokidar ../rlgym-server/app/**/*.py -c \\\"npm run gen:spec\\\" --silent\" \"chokidar ../rlgym-server/openapi.json -c \\\"npm run gen:api\\\" --silent\"",
    "prestart": "npm run gen:spec && npm run gen:api",
    "postinstall": "npm run gen:api"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@tailwindcss/postcss": "^4.1.12",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
